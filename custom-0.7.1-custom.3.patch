diff --git a/crates/engine/src/channel_cmds/tests.rs b/crates/engine/src/channel_cmds/tests.rs
index 9a9b710..9663e78 100644
--- a/crates/engine/src/channel_cmds/tests.rs
+++ b/crates/engine/src/channel_cmds/tests.rs
@@ -284,6 +284,19 @@ fn quick_mask_without_selection_and_options() {
     // Leaving an untouched Quick Mask leaves no selection.
     s.execute("select.editInQuickMaskMode", json!({"on": false})).unwrap();
     assert!(doc(&s).selection.is_none());
+
+    // Selected Areas with no selection must also start visually empty: its channel is black,
+    // not the all-white value that would tint the whole canvas red.
+    s.execute("channel.options", json!({"channel": "quickMask", "indicates": "selected"})).unwrap();
+    s.execute("select.editInQuickMaskMode", json!({"on": true})).unwrap();
+    let q = doc(&s).quick_mask.as_ref().unwrap();
+    assert_eq!(q.indicates, ColorIndicates::SelectedAreas);
+    assert!(q.surface.pixel(10, 10)[0] < 0.01, "Selected Areas empty start should be black");
+    s.execute("select.editInQuickMaskMode", json!({"on": false})).unwrap();
+    assert!(doc(&s).selection.is_none());
+
+    // Put the original Masked Areas mode back for the existing filter assertions below.
+    s.execute("channel.options", json!({"channel": "quickMask", "indicates": "masked"})).unwrap();
     // A filter in Quick Mask edits the mask.
     s.execute("select.editInQuickMaskMode", json!({})).unwrap();
     s.execute("paint.stroke", json!({"points": [[10, 10]], "size": 12, "hardness": 1.0, "color": "#000000"})).unwrap();
