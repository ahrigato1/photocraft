@@ -0,0 +1,95 @@
+//! Photoshop-style Quick Mask Options opened by double-clicking the toolbar's Quick Mask button.
+//!
+//! The engine already owns the actual Quick Mask settings (`channel.options {channel:"quickMask"}`).
+//! This module only supplies the small dedicated dialog and feeds that command on OK.
+
+use serde_json::{Map, Value, json};
+
+use crate::PhotocraftApp;
+use crate::state::DialogKind;
+
+const MARKER: &str = "__quickMaskOptions";
+
+/// Open Quick Mask Options with the current session values.
+pub fn open(app: &mut PhotocraftApp) -> u64 {
+    let o = app.session.quick_mask_options;
+    let mut fields = Map::new();
+    fields.insert(MARKER.into(), json!(true));
+    fields.insert("__label".into(), json!("Quick Mask Options"));
+    fields.insert("__command".into(), json!("channel.options"));
+    fields.insert("channel".into(), json!("quickMask"));
+    fields.insert(
+        "indicates".into(),
+        json!(match o.indicates {
+            photocraft_doc::ColorIndicates::MaskedAreas => "masked",
+            photocraft_doc::ColorIndicates::SelectedAreas => "selected",
+        }),
+    );
+    fields.insert("color".into(), json!(crate::color_picker_ui::hex(o.color.to_rgb())));
+    fields.insert("opacity".into(), json!((o.opacity * 100.0).round()));
+    app.ui.open_dialog(DialogKind::Command, fields)
+}
+
+pub fn owns(fields: &Map<String, Value>) -> bool {
+    fields.get(MARKER).and_then(Value::as_bool) == Some(true)
+}
+
+/// The compact Photoshop-style body: Color Indicates, overlay colour and opacity.
+pub fn body(ui: &mut egui::Ui, fields: &mut Map<String, Value>) {
+    ui.label(tl!("Color Indicates:"));
+    ui.add_space(2.0);
+
+    let current = fields.get("indicates").and_then(Value::as_str).unwrap_or("selected");
+    let mut indicates = current.to_string();
+    if ui.radio(indicates == "masked", tl!("Masked Areas")).clicked() {
+        indicates = "masked".into();
+    }
+    if ui.radio(indicates == "selected", tl!("Selected Areas")).clicked() {
+        indicates = "selected".into();
+    }
+    fields.insert("indicates".into(), json!(indicates));
+
+    ui.add_space(10.0);
+    crate::widgets::hairline(ui);
+    ui.add_space(10.0);
+
+    ui.horizontal(|ui| {
+        ui.label(tl!("Color:"));
+        let rgb = fields
+            .get("color")
+            .and_then(Value::as_str)
+            .and_then(crate::color_picker_ui::parse_hex)
+            .unwrap_or([1.0, 0.0, 0.0]);
+        let mut bytes = rgb.map(|v| (v.clamp(0.0, 1.0) * 255.0).round() as u8);
+        if crate::widgets::color_edit_button_srgb(ui, &mut bytes).changed() {
+            let rgb = bytes.map(|v| f32::from(v) / 255.0);
+            fields.insert("color".into(), json!(crate::color_picker_ui::hex(rgb)));
+        }
+
+        ui.add_space(18.0);
+        ui.label(tl!("Opacity:"));
+        let mut opacity = fields.get("opacity").and_then(Value::as_f64).unwrap_or(50.0) as f32;
+        if ui.add(egui::DragValue::new(&mut opacity).range(0.0..=100.0).speed(1.0).suffix(" %")).changed() {
+            fields.insert("opacity".into(), json!(opacity.clamp(0.0, 100.0)));
+        }
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use photocraft_doc::ColorIndicates;
+
+    #[test]
+    fn dialog_starts_from_the_session_quick_mask_options() {
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services::default());
+        app.session.quick_mask_options.indicates = ColorIndicates::SelectedAreas;
+        app.session.quick_mask_options.opacity = 0.37;
+        let id = open(&mut app);
+        let f = &app.ui.dialogs.iter().find(|d| d.id == id).unwrap().fields;
+        assert!(owns(f));
+        assert_eq!(f["indicates"], "selected");
+        assert_eq!(f["opacity"], 37.0);
+        assert_eq!(f["channel"], "quickMask");
+    }
+}
