+#[test]
+fn quick_mask_options_persist_across_sessions() {
+    use photocraft_doc::ColorIndicates;
+
+    let mut s = Session::new();
+    s.execute("file.new", json!({"width": 16, "height": 16})).unwrap();
+    s.execute(
+        "channel.options",
+        json!({"channel": "quickMask", "color": "#123456", "opacity": 37, "indicates": "selected"}),
+    )
+    .unwrap();
+
+    let saved = s.prefs_to_json();
+    let mut restored = Session::new();
+    restored.load_prefs_json(&saved).unwrap();
+    assert_eq!(restored.quick_mask_options.indicates, ColorIndicates::SelectedAreas);
+    assert!((restored.quick_mask_options.opacity - 0.37).abs() < 1e-6);
+    let rgb = restored.quick_mask_options.color.to_rgb();
+    assert!((rgb[0] - 0x12 as f32 / 255.0).abs() < 1e-6);
+    assert!((rgb[1] - 0x34 as f32 / 255.0).abs() < 1e-6);
+    assert!((rgb[2] - 0x56 as f32 / 255.0).abs() < 1e-6);
+}
