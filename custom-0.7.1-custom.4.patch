@@ -269,12 +269,26 @@ pub(crate) fn invoke_unguarded(app: &mut PhotocraftApp, ctx: &egui::Context, id:
         }
         "file.save" => {
-            // Writes back only to a layered file; a flat one goes through Save As.
+            // Custom parity: a flat document opened from a flat raster may save straight back
+            // to that same file. If the document gained layers/masks/effects, keep PhotoCraft's
+            // safe Save As behaviour so Ctrl+S never silently flattens editable structure.
             match params.get("path").and_then(Value::as_str) {
                 Some(path) => app.save_as(Some(path.to_string())),
-                None => match app.session.active().and_then(|d| d.path.clone()).filter(|p| photocraft_engine::file_cmds::saves_in_place(p)) {
-                    Some(path) => app.save_in_place(path),
-                    None => app.save_as(None),
-                },
+                None => {
+                    let path = app.session.active().and_then(|d| d.path.clone());
+                    match path {
+                        Some(path) if photocraft_engine::file_cmds::saves_in_place(&path) => app.save_in_place(path),
+                        Some(path)
+                            if app.session.active().is_some_and(|d| crate::plain_raster(&d.doc).is_some())
+                                && photocraft_engine::file_cmds::extension(&path)
+                                    .is_some_and(|ext| matches!(ext.as_str(), "png" | "jpg" | "jpeg" | "webp" | "bmp" | "tga")) =>
+                        {
+                            // save_as(Some(same_path)) goes through write_save; for a plain raster
+                            // it is not a copy, so the original is replaced and the dirty flag clears.
+                            app.save_as(Some(path))
+                        }
+                        _ => app.save_as(None),
+                    }
+                }
             }
         }
         "file.exit" => {
