 }
 
+/// Photoshop's Quick Mask painting polarity follows "Color Indicates". Internally PhotoCraft
+/// always stores white = selected; when the overlay indicates Selected Areas, black paint must
+/// therefore write white into the Quick Mask (and white paint must write black).
+pub(crate) fn quick_mask_paint_color(s: &Session, p: &Value, mut color: [f32; 4]) -> [f32; 4] {
+    if target_of(p) == Target::QuickMask && s.quick_mask_options.indicates == ColorIndicates::SelectedAreas {
+        color[0] = 1.0 - color[0];
+        color[1] = 1.0 - color[1];
+        color[2] = 1.0 - color[2];
+    }
+    color
+}
