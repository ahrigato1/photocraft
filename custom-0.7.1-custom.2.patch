+#[test]
+fn quick_mask_selected_areas_reverses_black_white_paint_polarity() {
+    use photocraft_doc::ColorIndicates;
+
+    let mut s = session(32, 32);
+    s.quick_mask_options.indicates = ColorIndicates::SelectedAreas;
+    s.execute("select.editInQuickMaskMode", json!({"on": true})).unwrap();
+    s.execute("tools.setColors", json!({"foreground": "#000000", "background": "#ffffff"})).unwrap();
+
+    // Selected Areas: black adds selection, so PhotoCraft's internal white=selected Quick Mask
+    // receives white. White paint then removes that selection (writes black).
+    s.execute(
+        "paint.stroke",
+        json!({"points": [[8, 8], [8, 8]], "size": 5, "hardness": 1, "color": "#000000", "target": "quickMask"}),
+    )
+    .unwrap();
+    let white = s.active().unwrap().doc.quick_mask.as_ref().unwrap().surface.pixel(8, 8)[0];
+    assert!(white > 0.9, "black should add selection in Selected Areas mode, got {white}");
+
+    s.execute(
+        "paint.stroke",
+        json!({"points": [[8, 8], [8, 8]], "size": 5, "hardness": 1, "color": "#ffffff", "target": "quickMask"}),
+    )
+    .unwrap();
+    let black = s.active().unwrap().doc.quick_mask.as_ref().unwrap().surface.pixel(8, 8)[0];
+    assert!(black < 0.1, "white should remove selection in Selected Areas mode, got {black}");
+}
